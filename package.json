{
  "name": "loopdesk",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "NODE_OPTIONS=\"--max-old-space-size=4096 $NODE_OPTIONS\" nuxt build && mkdir -p .output/server/db && cp -r server/db/migrations .output/server/db/migrations",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "generate:auth": "pnpm dlx auth@latest generate",
    "generate:migration": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "editor:test": "node --import tsx --test tests/markdown-editor.test.ts",
    "editor:test:browser": "node scripts/test-markdown-editor-browser.mjs",
    "agent:prompt": "node --import tsx scripts/preview-agent-prompt.ts",
    "agent:test": "node --env-file=.env --import tsx --test tests/agent-*.test.ts",
    "agent:search-eval": "node --env-file=.env --import tsx scripts/evaluate-agent-help-search.ts",
    "mcp:test": "node --import tsx --test tests/mcp*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.69",
    "@atlaskit/pragmatic-drag-and-drop": "^0.24.0",
    "@better-auth/core": "1.7.6",
    "@better-auth/mcp": "1.7.6",
    "@better-auth/oauth-provider": "1.7.6",
    "@better-auth/utils": "0.4.2",
    "@codemirror/commands": "6.3.0",
    "@codemirror/lang-markdown": "6.2.2",
    "@codemirror/language": "6.9.2",
    "@codemirror/state": "6.3.1",
    "@codemirror/view": "6.22.0",
    "@mastra/ai-sdk": "1.10.3",
    "@mastra/core": "1.67.0",
    "@mastra/memory": "1.30.0",
    "@mastra/pg": "1.25.0",
    "@modelcontextprotocol/server": "2.2.0",
    "@nuxt/eslint": "1.15.2",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/hints": "1.0.0-alpha.10",
    "@nuxt/icon": "2.2.1",
    "@nuxt/image": "1.0.0",
    "@nuxthub/core": "0.10.7",
    "@nuxtjs/i18n": "7.3.1",
    "@nuxtjs/seo": "3.4.0",
    "@pinia/nuxt": "0.5.1",
    "@tiptap/core": "2.1.12",
    "@tiptap/extension-code": "2.1.12",
