{
  "name": "loopdesk",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "NODE_OPTIONS=\"--max-old-space-size=4096 $NODE_OPTIONS\" nuxt build && mkdir -p .output/server/db && cp -r server/db/migrations .output/server/db/migrations",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "generate:migration": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/eslint": "1.15.2",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/hints": "1.0.0-alpha.10",
    "@nuxt/icon": "2.2.1",
    "@nuxt/image": "1.0.0",
    "@nuxthub/core": "0.10.7",
    "@nuxtjs/i18n": "7.3.1",
    "@nuxtjs/seo": "3.4.0",
    "@pinia/nuxt": "0.5.1",
    "@vueuse/core": "^10.6.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "drizzle-kit": "^0.20.2",
    "drizzle-orm": "^0.29.0",
    "lucide-vue-next": "^0.292.0",
    "markdown-it": "13.0.2",
    "nuxt": "^3.8.1",
    "pg": "8.11.3",
    "reka-ui": "^2.9.0",
    "shadcn-nuxt": "2.4.3",
    "tailwind-merge": "^2.0.0",
    "uuidv7": "^0.6.3",
    "vue-sonner": "^1.0.2",
    "zod": "^3.22.4"
  },
  "packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b",
  "devDependencies": {
    "@iconify-json/logos": "^1.1.37",
    "@iconify-json/lucide": "^1.1.141",
    "@iconify-json/mdi": "^1.1.55",
    "@nuxtjs/tailwindcss": "6.9.4",
    "@types/node": "^20.9.0",
    "@types/pg": "^8.10.9",
    "h3": "1.8.2",
    "tailwindcss": "^3.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.2.2",
    "vue-tsc": "1.8.22"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "linux"
      ],
      "cpu": [
        "current",
        "x64",
        "arm64"
      ],
      "libc": [
        "current",
        "glibc"
      ]
    }
  },
  "cloudflare": {
    "bindings": {
      "POSTGRES": {
        "description": "Hyperdrive config that accelerates your Postgres connection. Create one or pick an existing config. Needs a Postgres URL with the `vector` extension enabled (Neon and Supabase both support it)."
      },
      "BLOB": {
        "description": "R2 bucket for uploaded files (images on feedback posts). Create a new bucket or pick an existing one. Skipping this disables file uploads but the app still works."
      }
    }
  }
}
